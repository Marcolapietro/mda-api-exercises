# Environment variables used by the exercises (reference list - the apps do NOT read
# this file automatically). Set them in the terminal where you run the app:
#   Linux/macOS:        export NAME="value"
#   Windows PowerShell: $env:NAME="value"
#   Windows CMD:        set NAME=value
#
# Every exercise also runs WITHOUT these: secrets are then generated randomly at
# startup (tokens stop working when you restart the app).
#
# Exercises 10 to 15 do read a .env file: the one in their own folder (copy the
# .env.example of that folder to .env).

# Exercise 06b (MySQL in Docker) reads the .env of its own folder: copy
# exercises/06b-mysql-database/.env.example to .env there. Same values:
#   MYSQL_HOST=127.0.0.1  MYSQL_PORT=3306  MYSQL_DATABASE=library
#   MYSQL_USER=library    MYSQL_PASSWORD=library-pass  MYSQL_ROOT_PASSWORD=root-pass

# Signing key for JWTs (exercises 10-15). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Signing key for the session cookie (exercise 13)
SESSION_SECRET=

# Password of the bootstrap 'admin' user (exercise 12). If empty, a random one is printed at startup.
ADMIN_PASSWORD=

# OpenWeatherMap key (exercise 10) - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# GitHub OAuth App credentials (exercise 13) - GitHub > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret shared with GitHub to sign webhook deliveries (exercise 16). Use any long random string.
GITHUB_WEBHOOK_SECRET=

# Exercise 17 (MCP): if set, the Notes API requires it in X-API-Key, and the MCP server sends it.
# Set the same value in both terminals (and in the "env" of your assistant's MCP config).
NOTES_API_KEY=
# Exercise 17: where the Notes API runs (default http://127.0.0.1:8000)
NOTES_API_URL=
# Exercise 17: 1 = also expose the destructive delete_note tool
NOTES_ALLOW_DELETE=0
