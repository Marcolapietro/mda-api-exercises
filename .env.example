# Environment variables used by the exercises (reference list - the apps do NOT read
# this file automatically). Set them in the terminal where you run the app:
#   Linux/macOS:        export NAME="value"
#   Windows PowerShell: $env:NAME="value"
#   Windows CMD:        set NAME=value
#
# Every exercise also runs WITHOUT these: secrets are then generated randomly at
# startup (tokens stop working when you restart the app).

# Flask: 1 = debug mode with auto-reload. Never enable it on an app exposed with ngrok.
FLASK_DEBUG=0

# Signing key for JWTs (exercises 06-14). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Flask session key (exercises 10 and 14)
FLASK_SECRET_KEY=

# Password of the bootstrap 'admin' user (exercise 10). If empty, a random one is printed at startup.
ADMIN_PASSWORD=

# OpenWeatherMap key (exercise 07) - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# GitHub OAuth App credentials (exercise 14) - GitHub > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
