# Copy this file to .env and put your values in the copy:
#   Linux/macOS: cp .env.example .env      Windows: copy .env.example .env
# .env is in .gitignore and must never be committed; this template has no secrets and is committed.
# The app reads .env at startup: after changing it, stop the app (Ctrl+C) and start it again.

# GitHub OAuth App credentials (required) - GitHub > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: signs the session cookie that holds the OAuth state and the PKCE verifier.
# If empty, a random one is generated at every start. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: signing key for the JWTs. If empty, a random one is generated at every start,
# so tokens stop working after each reload. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
